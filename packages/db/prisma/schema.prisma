// FND contracts (docs/specs/001-foundation.md, "Contracts touched"). Minimal columns only (Decision 2):
// later specs add columns by migration. Tables and columns are snake_case in Postgres.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EMPLOYEE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// MSG: text only (MSG Decision 2); inbound media is kept as UNSUPPORTED with its kind (MSG-05).
enum MessageType {
  TEXT
  UNSUPPORTED
}

// MSG: outbound only, forward-only (MSG-20). Inbound messages have no status.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageFailureReason {
  WA_NOT_CONNECTED
  PROVIDER_ERROR
  REPORTED_FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         Role
  active       Boolean    @default(true)
  auditLogs    AuditLog[]
  messagesSent Message[]

  @@map("users")
}

model Contact {
  id           String        @id @default(uuid()) @db.Uuid
  phone        String        @unique // E.164
  name         String?
  isTest       Boolean       @default(false) @map("is_test")
  createdAt    DateTime      @default(now()) @map("created_at")
  conversation Conversation?

  @@map("contacts")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  contactId     String    @unique @map("contact_id") @db.Uuid
  contact       Contact   @relation(fields: [contactId], references: [id])
  // MSG: the newest message's `at`; never moves backward (MSG-02).
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String                @id @default(uuid()) @db.Uuid
  conversationId    String                @map("conversation_id") @db.Uuid
  conversation      Conversation          @relation(fields: [conversationId], references: [id])
  // Null until the provider returns an ID (outbound messages are saved as queued first).
  providerMessageId String?               @unique @map("provider_message_id")
  direction         MessageDirection
  // MSG columns. `type` and `at` have defaults so FND-05's raw inserts stay valid (MSG Decision 18).
  type              MessageType           @default(TEXT)
  body              String?
  unsupportedKind   String?               @map("unsupported_kind")
  status            MessageStatus?
  failureReason     MessageFailureReason? @map("failure_reason")
  statusAt          DateTime?             @map("status_at")
  // Null for inbound and for "Sent from phone" (MSG-06). Restrict: deleting a sender must never
  // turn their messages into "Sent from phone" (users are deactivated, not deleted).
  sentById          String?               @map("sent_by_id") @db.Uuid
  sentBy            User?                 @relation(fields: [sentById], references: [id], onDelete: Restrict)
  // Repeated sends with the same client id return the first message (MSG-13).
  clientId          String?               @map("client_id") @db.Uuid
  // The WhatsApp timestamp for messages from WhatsApp, the queue time for CRM sends (Decision 7).
  at                DateTime              @default(now())
  createdAt         DateTime              @default(now()) @map("created_at")

  @@unique([conversationId, clientId])
  @@index([conversationId, at])
  @@map("messages")
}

enum WhatsAppProvider {
  FAKE
  BAILEYS
}

// WA: one session per provider, so switching WHATSAPP_PROVIDER never loads the other one's
// credentials. `number` is known only after pairing. Values are AES-256-GCM encrypted (WA-06).
model WhatsAppSession {
  id             String               @id @default(uuid()) @db.Uuid
  provider       WhatsAppProvider     @unique
  number         String?              @unique
  encryptedCreds String               @map("encrypted_creds")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  keys           WhatsAppSessionKey[]

  @@map("whatsapp_sessions")
}

// WA: the provider's signal keys, one row per (type, id), written as the provider updates them.
model WhatsAppSessionKey {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  session        WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           String
  keyId          String          @map("key_id")
  encryptedValue String          @map("encrypted_value")

  @@unique([sessionId, type, keyId])
  @@map("whatsapp_session_keys")
}

// Insert-only from application code (enforced in AUD).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  ip        String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
