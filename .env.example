# Copy to `.env` in the repo root: `cp .env.example .env`. `pnpm dev` loads it for the api and
# worker; a variable set in the real environment wins over the file. Never commit `.env`.
# Schemas: packages/shared/src/env.ts (ApiEnv, WorkerEnv, SeedEnv).

# --- api and worker ---

# development | test | production. Production turns on the Secure cookie and blocks seeding.
NODE_ENV=development
# Postgres from docker-compose.yml (dev database). Tests use crm_test and set their own URL.
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_dev
# Redis from docker-compose.yml.
REDIS_URL=redis://localhost:6379

# --- api ---

# HTTP port.
PORT=4000
# Session secret for login sessions (FND auth). At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated browser origins allowed to open sockets and send non-GET requests (WA-21, WA-22).
# No CORS headers are sent: the web app reaches the api through the Vite proxy (same origin).
ALLOWED_ORIGINS=http://localhost:5173
# Session lifetime in seconds (12 hours).
SESSION_TTL_SECONDS=43200
# Failed logins per email allowed within LOGIN_WINDOW_SECONDS before further attempts get 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- worker ---

# AES-256-GCM key for the stored WhatsApp session: 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
# WhatsApp provider: `fake` (default, simulated, auto-pairs after a few seconds) or `baileys`
# (the real test number; scan the QR on the connection page).
WHATSAPP_PROVIDER=fake
# Single-session lock TTL in ms. A standby worker takes over at most about TTL + TTL/6 after a crash.
WA_LOCK_TTL_MS=30000
# Reconnect backoff after a network drop: base delay, doubled per attempt up to the max (ms).
WA_RECONNECT_BASE_MS=1000
WA_RECONNECT_MAX_MS=60000

# --- seed only ---

# Password for every seeded user. Defaults to the documented dev password `crm-dev-password`.
SEED_PASSWORD=
