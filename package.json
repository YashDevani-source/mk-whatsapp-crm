{
  "name": "mk-whatsapp-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "test": "vitest run && pnpm -r --workspace-concurrency=1 test",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-dependency-graph.ts --root .",
    "migrate": "pnpm --filter @crm/db migrate",
    "seed": "pnpm --filter @crm/db seed",
    "traceability": "node scripts/traceability.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
